{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attune.local/contracts/device-capability-discovery.v1.schema.json",
  "title": "Attune DeviceCapabilityDiscovery v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "devices",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "devices": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "name",
          "profile_key",
          "parent_device_id",
          "online"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "profile_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "parent_device_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "online": {
            "type": "boolean"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "capability-descriptor.v1.schema.json"
      }
    }
  }
}
