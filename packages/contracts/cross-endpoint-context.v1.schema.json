{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attune.local/contracts/cross-endpoint-context.v1.schema.json",
  "title": "Attune CrossEndpointContext v1",
  "description": "Server-owned authorization/audit context. It is evidence, never an Edge authority grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "workspace_id",
    "actor_type",
    "actor_id",
    "source_kind",
    "source_device_id",
    "target_device_id",
    "parent_device_id",
    "required_action",
    "policy_version",
    "authorization_revision",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_type": {
      "enum": [
        "user",
        "service",
        "device_principal"
      ]
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/-]{1,256}$"
    },
    "source_kind": {
      "enum": [
        "web",
        "windows",
        "android_car",
        "soft_router",
        "voice",
        "mcp",
        "automation",
        "system"
      ]
    },
    "source_device_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "target_device_id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_device_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "required_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "authorization_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
